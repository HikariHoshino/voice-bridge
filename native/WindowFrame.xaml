<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource RootBrush}">
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="CaptionBar" Margin="12,0,6,0">
    <TextBlock x:Name="CaptionTitle" FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="SemiBold"
               Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,112,0"/>
    <StackPanel x:Name="CaptionActions" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="CaptionMinimize" Width="30" Height="28" CornerRadius="9" Padding="0" Background="Transparent" AutomationProperties.Name="最小化" ToolTipService.ToolTip="最小化">
        <Path Data="M2 7 L12 7" Width="14" Height="14" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>
      <Button x:Name="CaptionMaximize" Width="30" Height="28" CornerRadius="9" Padding="0" Background="Transparent" AutomationProperties.Name="最大化" ToolTipService.ToolTip="最大化">
        <Grid Width="14" Height="14">
          <Path x:Name="MaximizeGlyph" Data="M2 2 L12 2 L12 12 L2 12 Z" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
          <Path x:Name="RestoreGlyph" Visibility="Collapsed" Data="M2 5 L9 5 L9 12 L2 12 Z M5 5 L5 2 L12 2 L12 9 L9 9" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
        </Grid>
      </Button>
      <Button x:Name="CaptionClose" Width="30" Height="28" CornerRadius="9" Padding="0" Background="Transparent" Foreground="{ThemeResource DangerInkBrush}" AutomationProperties.Name="关闭" ToolTipService.ToolTip="关闭">
        <Path Data="M3 3 L11 11 M11 3 L3 11" Width="14" Height="14" Stroke="{ThemeResource DangerInkBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>
    </StackPanel>
  </Grid>
  <Grid x:Name="WindowBody" Grid.Row="1"/>
</Grid>
