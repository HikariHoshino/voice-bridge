<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" Background="{ThemeResource RootBrush}">
  <Grid x:Name="Layout" Margin="18,18,18,38">
    <Grid.RowDefinitions><RowDefinition Height="109"/><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="59"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="13">
        <Image x:Name="Logo" Width="48" Height="48"/>
        <StackPanel><TextBlock x:Name="MainTitle" Text="声桥" Style="{StaticResource TitleStyle}"/><TextBlock x:Name="Subtitle" Text="用手机说，在电脑上写" Foreground="{ThemeResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
        <Button x:Name="ThemeButton" Width="40" Height="40" CornerRadius="20" Padding="0" AutomationProperties.Name="切换深浅色主题" ToolTipService.ToolTip="切换深浅色主题"/>
        <Button x:Name="SettingsButton" Width="40" Height="40" CornerRadius="20" Padding="0" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"/>
      </StackPanel>
    </Grid>
    <Border x:Name="ConnectionCard" Grid.Row="1" CornerRadius="22" Background="{ThemeResource CardBrush}" Padding="27" Margin="0,0,0,12">
      <Grid>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ConnectionTitle" Text="手机连接" Style="{StaticResource CardTitleStyle}"/><TextBlock x:Name="ConnectionSubtitle" Text="已配对手机可直接打开收藏页面" Style="{StaticResource MutedStyle}" Margin="0,2,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
          <Button x:Name="QrButton" Width="40" Height="40" CornerRadius="20" Padding="0" AutomationProperties.Name="手机配对二维码" ToolTipService.ToolTip="手机配对二维码"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="TransferCard" Grid.Row="2" CornerRadius="22" Background="{ThemeResource CardBrush}" Padding="27" MinHeight="118" Margin="0,0,0,12">
      <Grid x:Name="TransferLayout">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TransferTitle" Text="电脑 → 手机" Style="{StaticResource CardTitleStyle}"/><TextBlock x:Name="TransferSubtitle" Text="展开后输入文字并发送到手机当前光标" Style="{StaticResource MutedStyle}" Margin="0,2,0,0"/></StackPanel>
          <Button x:Name="TransferButton" Width="40" Height="40" CornerRadius="20" Padding="0" HorizontalAlignment="Right" AutomationProperties.Name="展开电脑到手机" ToolTipService.ToolTip="展开或收起"/>
        </Grid>
        <Grid x:Name="TransferContent" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0" MinHeight="168">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
          <TextBox x:Name="DesktopText" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" FontSize="13.333" Background="{ThemeResource InputBrush}" Foreground="{ThemeResource InkBrush}" BorderThickness="0" CornerRadius="12" Padding="12,5" Margin="0,0,0,10" AutomationProperties.Name="发送到手机的文字" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          <Grid Grid.Row="1"><TextBlock x:Name="ShortcutHint" Style="{StaticResource MutedStyle}" VerticalAlignment="Center"/><Button x:Name="SendButton" Content="发送到手机" Width="122" Background="#2563EB" Foreground="White" HorizontalAlignment="Right"/></Grid>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="StatusCard" Grid.Row="3" CornerRadius="12" Background="{ThemeResource StatusBrush}" Padding="18,15">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="●" Foreground="#10B981" FontSize="12"/><TextBlock x:Name="StatusText" Text="等待手机连接" Foreground="{ThemeResource StatusInkBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
        <TextBlock x:Name="CountText" Grid.Column="1" Foreground="{ThemeResource StatusInkBrush}" FontSize="12" Margin="8,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Grid>
