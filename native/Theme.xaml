<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RootBrush" Color="#F3F6FB"/>
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="InkBrush" Color="#132238"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
          <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="LineBrush" Color="#DBE4F0"/>
          <SolidColorBrush x:Key="SecondaryBrush" Color="#EDF2F8"/>
          <SolidColorBrush x:Key="StatusBrush" Color="#E8F7F0"/>
          <SolidColorBrush x:Key="StatusInkBrush" Color="#176B4D"/>
          <SolidColorBrush x:Key="DangerBrush" Color="#FFF1F2"/>
          <SolidColorBrush x:Key="DangerInkBrush" Color="#BE123C"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RootBrush" Color="#0F172A"/>
          <SolidColorBrush x:Key="CardBrush" Color="#182235"/>
          <SolidColorBrush x:Key="InkBrush" Color="#E5EDF8"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#9CAFC5"/>
          <SolidColorBrush x:Key="InputBrush" Color="#111827"/>
          <SolidColorBrush x:Key="LineBrush" Color="#334155"/>
          <SolidColorBrush x:Key="SecondaryBrush" Color="#263449"/>
          <SolidColorBrush x:Key="StatusBrush" Color="#15352F"/>
          <SolidColorBrush x:Key="StatusInkBrush" Color="#6EE7B7"/>
          <SolidColorBrush x:Key="DangerBrush" Color="#3B202B"/>
          <SolidColorBrush x:Key="DangerInkBrush" Color="#FDA4AF"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
        <Setter Property="FontSize" Value="13.333"/>
      </Style>
      <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="29.333"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
      </Style>
      <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="14.667"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
      </Style>
      <Style x:Key="MutedStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource SecondaryBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.06"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.14"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Body.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
                <Border x:Name="Hover" Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>